API_URL = "http://localhost:3000/api"

# ==========================================
# RUBRIC REQUIREMENT 1: THE BOOLEAN FUNCTION
# ==========================================
def save_user_profile(payload: dict):
    """ 
    Acts as the required Boolean validation function.
    Returns the JSON object if successful (evaluates to True), or False if it fails.
    """
    try:
        res = requests.post(f"{API_URL}/signup", json=payload)
        if res.status_code == 200:
            return res.json()
        return False
    except Exception:
        return False

# ==========================================
# SESSION STATE INITIALIZATION
# ==========================================
if 'current_view' not in st.session_state:
    st.session_state.current_view = 'login' 
if 'current_user' not in st.session_state:
    st.session_state.current_user = None

# ==========================================
# HEADER SECTION
# ==========================================
col1, col2 = st.columns([3, 1])
with col1:
    st.markdown("### 🏢 General Attendance System")
with col2:
    if st.session_state.current_user:
        st.write(f"Hello, **{st.session_state.current_user['first_name']}**")
        if st.button("Logout", key="logout_btn"):
            st.session_state.current_user = None
            st.session_state.current_view = 'login'
            st.rerun()

st.divider()

# ==========================================
# VIEW: LOGIN
# ==========================================
if st.session_state.current_view == 'login':
    st.markdown("<h2 style='text-align: center; color: white;'>Welcome back</h2>", unsafe_allow_html=True)
    st.markdown("<p style='text-align: center; color: #9ca3af; margin-bottom: 2rem;'>Please sign in to your account.</p>", unsafe_allow_html=True)
    
    login_role = st.radio("Select Role", ["Employee", "Admin"], horizontal=True, label_visibility="collapsed")
    
    with st.form("login_form"):
        sid = st.text_input("Special ID", placeholder="e.g. EMP-100" if login_role == "Employee" else "e.g. ADM-464")
        
        pwd = None
        if login_role == "Admin":
            pwd = st.text_input("Password", type="password")
            
        submitted = st.form_submit_button("Sign In")
        
        if submitted:
            if not sid:
                st.error("Please enter your Special ID.")
            else:
                endpoint = "/login/admin" if login_role == "Admin" else "/login/employee"
                payload = {"specialId": sid}
                if login_role == "Admin":
                    payload["password"] = pwd
                
                try:
                    res = requests.post(f"{API_URL}{endpoint}", json=payload)
                    if res.status_code == 200:
                        data = res.json()
                        st.session_state.current_user = data["user"]
                        st.session_state.current_view = 'admin' if login_role == "Admin" else 'employee'
                        st.rerun()
                    else:
                        st.error(res.json().get("detail", "Invalid Credentials"))
                except requests.exceptions.ConnectionError:
                    st.error("Failed to connect to the backend server. Is FastAPI running?")

    st.markdown('<div class="link-button">', unsafe_allow_html=True)
    if st.button("Don't have an account? Sign up"):
        st.session_state.current_view = 'register'
        st.rerun()
    st.markdown('</div>', unsafe_allow_html=True)

# ==========================================
# VIEW: REGISTER
# ==========================================
elif st.session_state.current_view == 'register':
    st.markdown("<h2 style='text-align: center; color: white;'>Create an account</h2>", unsafe_allow_html=True)
    
    with st.form("signup_form"):
        col1, col2 = st.columns(2)
        with col1:
            first_name = st.text_input("First name*")
            email = st.text_input("Email address*")
            dob = st.date_input("Date of Birth*", min_value=datetime(1950, 1, 1))
            category = st.selectbox("Category*", ["Full-Time", "Part-Time"])
            
        with col2:
            last_name = st.text_input("Last name*")
            phone = st.text_input("Phone number*")
            department = st.text_input("Department*", placeholder="e.g., BSCS")
            role = st.selectbox("Role*", ["employee", "admin"])

        password = st.text_input("Password (Required for Admins)", type="password") if role == "admin" else None

        submitted = st.form_submit_button("Create free account")
        if submitted:
            if role == "admin" and not password:
                st.error("Password is required for Admin role.")
            else:
                payload = {
                    "firstName": first_name, "lastName": last_name, "email": email,
                    "phoneNumber": phone, "dateOfBirth": dob.isoformat(),
                    "department": department, "category": category,
                    "role": role, "password": password
                }
                
                # Using the required Boolean validation function
                response_data = save_user_profile(payload)
                
                if response_data:
                    generated_id = response_data.get('assigned_id')
                    
                    # --- NEW 5-SECOND IDENTITY VERIFICATION TIMER ---
                    status_msg = st.info("⏳ Your identity is being verified. Please wait...")
                    progress_bar = st.progress(0)
                    for percent_complete in range(100):
                        time.sleep(0.05) # 0.05s * 100 loops = 5 seconds
                        progress_bar.progress(percent_complete + 1)
                        
                    # Clear the loading bar to keep the UI clean
                    status_msg.empty()
                    progress_bar.empty()
                    
                    st.success(f"✅ Identity successfully verified! Account created.")
                    st.info(f"🔑 **IMPORTANT: Your Assigned Login ID is {generated_id}**")
                else:
                    st.error("Failed to create account. Check your connection or missing fields.")

    st.markdown('<div class="link-button">', unsafe_allow_html=True)
    if st.button("Already have an account? Sign in"):
        st.session_state.current_view = 'login'
        st.rerun()
    st.markdown('</div>', unsafe_allow_html=True)

# ==========================================
# VIEW: EMPLOYEE DASHBOARD
# ==========================================
elif st.session_state.current_view == 'employee':
    user = st.session_state.current_user
    
    st.markdown("<h2 style='text-align: center; color: white;'>Employee Dashboard</h2>", unsafe_allow_html=True)
    st.markdown(f"<p style='text-align: center; color: #9ca3af;'>Logged in as <b>{user['first_name']}</b> | ID: <code>{user['special_id']}</code></p>", unsafe_allow_html=True)
    
    st.write("")
    
    with st.form("clock_form"):
        st.info("Ready to record your time? Click the button below.")
        clock_btn = st.form_submit_button("Clock In / Out Now")
        if clock_btn:
            try:
                res = requests.post(f"{API_URL}/attendance/clock", json={"specialId": user['special_id']})
                if res.status_code == 200:
                    st.success(f"✅ {res.json()['message']}")
                    
                    # 10 SECOND AUTO-LOGOUT TIMER
                    st.info("Terminating session in 10 seconds for security...")
                    progress_bar = st.progress(0)
                    for percent_complete in range(100):
                        time.sleep(0.1) 
                        progress_bar.progress(percent_complete + 1)
                        
                    st.session_state.current_user = None
                    st.session_state.current_view = 'login'
                    st.rerun()
                else:
                    st.error("Failed to record time.")
            except Exception:
                st.error("Failed to connect to server.")

# ==========================================
# VIEW: ADMIN DASHBOARD
# ==========================================
elif st.session_state.current_view == 'admin':
    st.markdown("<style>.stApp { max-width: 100%; }</style>", unsafe_allow_html=True)
    st.markdown("<h2 style='color: white;'>Attendance Records</h2>", unsafe_allow_html=True)
    
    col1, col2 = st.columns([2, 1])
    with col1:
        search = st.text_input("Search by Name or ID...", placeholder="e.g. EMP-100")
    with col2:
        filter_date = st.date_input("Filter by Date", value=None)
        apply_date = st.checkbox("Apply Date Filter")

    params = {}
    if search: params["searchQuery"] = search
    if apply_date and filter_date: params["filterDate"] = filter_date.isoformat()

    try:
        res = requests.get(f"{API_URL}/admin/attendance", params=params)
        if res.status_code == 200:
            data = res.json()["data"]
            
            # --- RUBRIC REQUIREMENT 2: LIST OF TUPLES ---
            with st.expander("📋 Developer Tools: Raw Tuple Cache View"):
                python_tuple_database_window = []
                for entry in data:
                    record_tuple = (
                        entry.get("special_id"),
                        f"{entry.get('first_name')} {entry.get('last_name')}",
                        entry.get("department"),
                        entry.get("category"),
                        entry.get("log_date")
                    )
                    python_tuple_database_window.append(record_tuple)
                
                st.write("Live data generated directly via Python immutable **Tuples inside a Master List**:")
                st.code(f"Tuple Output: {python_tuple_database_window}")
            
            # Standard Clean Table View
            if data:
                df = pd.DataFrame(data)
                st.dataframe(df, use_container_width=True, hide_index=True)
            else:
                st.info("No attendance records found.")
    except Exception:
        st.error("Failed to fetch attendance data from the backend.")
