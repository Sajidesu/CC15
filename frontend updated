import streamlit as st
import requests
import pandas as pd
from datetime import datetime

# ==========================================
# PAGE CONFIGURATION & CUSTOM CSS
# ==========================================
st.set_page_config(page_title="General Attendance System", page_icon="🏢", layout="centered")

# Custom CSS to mimic the sleek dark theme from the screenshot
st.markdown("""
